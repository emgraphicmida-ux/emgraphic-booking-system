# ========================================================
# Emgraphic Studio - Nginx Reverse Proxy Konfiqurasiyası
# Faylı /etc/nginx/sites-available/emgraphic ünvanına kopyalayın
# və sudo ln -s /etc/nginx/sites-available/emgraphic /etc/nginx/sites-enabled/ edin.
# ========================================================

server {
    listen 80;
    listen [::]:80;
    server_name emgraphic.az www.emgraphic.az; # <-- Öz domen adınızı bura yazın

    # Loqo və şəkil yükləmələri üçün ölçü həddi
    client_max_body_size 20M;

    # Gzip sıxılma (saytın dərhal və sürətli açılması üçün)
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript image/svg+xml;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;

        # Timeout sazlamaları
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}

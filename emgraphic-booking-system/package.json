{
  "name": "emgraphic-booking-system",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@11.21.1",
  "engines": { "node": ">=24.0.0", "npm": ">=11.0.0" },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --platform=node --format=esm --target=node20 --outfile=server.js --bundle --packages=external",
    "preview": "vite preview",
    "start": "node server.js",
    "preview:local": "node scripts/start-preview.mjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:api": "node --import tsx --test tests/*.test.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "esbuild": "^0.28.2",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tsx": "^4.21.0",
    "vite": "^8.3.0"
  },
  "overrides": {
    "body-parser": "1.20.9",
    "ip-address": "10.7.4"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
}
